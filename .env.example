# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Production must use sk_live_/pk_live_; Preview/Dev must use sk_test_/pk_test_.
# Never share webhook secrets across environments (each endpoint URL has its own secret).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# ShootPortal SaaS billing (platform → business subscriptions). Separate endpoint
# from tenant→client payments (STRIPE_WEBHOOK_SECRET) and Connect.
# Dashboard → Webhooks → https://…/api/stripe/webhook/billing
# Events: customer.subscription.*, invoice.paid, invoice.payment_failed,
# checkout.session.completed (subscription mode), charge.refunded, invoice.voided.
# Do not add charge.dispute.* in partner-commission V1.
STRIPE_BILLING_WEBHOOK_SECRET=
# Connect endpoint (Dashboard → Workbench → Webhooks → Events from: Connected accounts)
# Signing secret is different from STRIPE_WEBHOOK_SECRET. Local CLI:
#   stripe listen --forward-connect-to localhost:3000/api/stripe/webhook/connect
STRIPE_CONNECT_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated custom domain hosts where Google OAuth may be shown.
# Must match hosts allowlisted in Supabase Auth → Redirect URLs
# (e.g. https://portal.swiftaerialmedia.com/auth/callback).
# Apex and *.PLATFORM_ROOT_DOMAIN are always allowed; custom domains are not
# wildcarded by Supabase, so operators must update BOTH this list and the Auth
# allowlist when adding a custom domain. Missing either → Google button hidden,
# password sign-in still works (no silent wrong-host redirect).
NEXT_PUBLIC_OAUTH_ALLOWED_CUSTOM_HOSTS=portal.swiftaerialmedia.com,portal.jacksonbridges.com

# Platform identity (not a tenant).
PLATFORM_ROOT_DOMAIN=shootportal.app
PLATFORM_EMAIL_DOMAIN=shootportal.app
PLATFORM_FROM_ADDRESS=noreply@shootportal.app
PLATFORM_REPLY_TO=
PLATFORM_SESSION_SECRET=

# GoHighLevel — server-only inbound webhook for new portal project requests (Swift fallback)
GHL_PORTAL_LEAD_WEBHOOK_URL=


# OneSignal (admin web push) — REST API key is server-only
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Email (Resend) — optional locally; required in Production
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Shared sending domain (verified in the Resend account). New businesses send as:
#   "{businessName}" <noreply@{PLATFORM_EMAIL_DOMAIN}>
# with Reply-To = their primary contact. Do not let tenants set senderEmail to this domain.
# Defaults (if unset): shootportal.app / noreply@shootportal.app

# Custom domains — Vercel project API (self-serve portal.theirdomain.com)
# Prefer a project-scoped token. Team projects also need VERCEL_TEAM_ID.
# If unset, Settings → Custom Domain shows manual DNS + contact support.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Crons — Vercel sends Authorization: Bearer <CRON_SECRET> when this env is set.
# See vercel.json (daily UTC). Docs: docs/PRODUCTION-ENV.md, docs/OPERATIONS.md
CRON_SECRET=
# Backlog safety for /api/cron/workflow-reminders. Unset = no historical reminders.
# After dry-run (scripts/dry-run-workflow-reminders.ts), set to a past UTC ISO to enable, e.g.:
# WORKFLOW_REMINDER_ANCHOR_NOT_BEFORE=2026-08-14T00:00:00.000Z
WORKFLOW_REMINDER_ANCHOR_NOT_BEFORE=
