# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect endpoint (Dashboard → Workbench → Webhooks → Events from: Connected accounts)
# Signing secret is different from STRIPE_WEBHOOK_SECRET. Local CLI:
#   stripe listen --forward-connect-to localhost:3000/api/stripe/webhook/connect
STRIPE_CONNECT_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GoHighLevel — server-only inbound webhook for new portal project requests
GHL_PORTAL_LEAD_WEBHOOK_URL=

# Google Calendar (optional — admin shoot sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {NEXT_PUBLIC_APP_URL}/api/google-calendar/callback if unset
GOOGLE_REDIRECT_URI=

# OneSignal (admin web push) — REST API key is server-only
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Email (Resend) — optional; in-app notifications work without this
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Shared sending domain (verified in the Resend account). New businesses send as:
#   "{businessName}" <noreply@{PLATFORM_EMAIL_DOMAIN}>
# with Reply-To = their primary contact. Do not let tenants set senderEmail to this domain.
PLATFORM_EMAIL_DOMAIN=
PLATFORM_FROM_ADDRESS=

# Workflow reminders cron (optional) — GET /api/cron/workflow-reminders with Authorization: Bearer <secret>
CRON_SECRET=
